{
  "name": "av-music",
  "private": true,
  "version": "0.6.4",
  "type": "module",
  "description": "Reproductor de música local elegante, rápido y moderno de escritorio con resolución limpia de metadatos, búsqueda, descarga sin sesión y letras sincronizadas.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tauri": "tauri",
    "bump": "node scripts/bump-version.mjs",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "postinstall": "tauri icon -o src-tauri/icons src-tauri/icons/app-icon.png"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "ffmpeg-static": "^5.3.0",
    "globals": "^15.15.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
