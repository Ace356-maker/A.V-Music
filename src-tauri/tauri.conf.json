{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A.V Music",
  "mainBinaryName": "av-music",
  "version": "0.7.1",
  "identifier": "com.avmusic.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "A.V Music",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#141414"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzMEZEMzE1Q0REMjkxQ0QKUldUTmtkTE5GZE1QSS9tbWZ5cCs1cSs2dWFJb0hnR0twU0lKRStKVkdCaGZCR2NoVGNTRWNGMjcK",
      "endpoints": [
        "https://github.com/Ace356-maker/A.V-Music/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
